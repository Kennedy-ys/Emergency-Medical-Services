# Copy to .env.local and fill in. Never commit .env.local.
# Values are in the Supabase dashboard under Project Settings -> API.
# Only browser-safe values belong here: the service role key must never be
# placed in a VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public half of the push notification key pair (docs/07-PUSH-SETUP.md).
# The private half is a Supabase function secret and never goes in any file here.
VITE_VAPID_PUBLIC_KEY=
